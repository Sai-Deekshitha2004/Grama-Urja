<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crop_hint"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCropName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Crop name..."
        android:inputType="textCapWords"
        android:importantForAutofill="no" />

    <Button
        android:id="@+id/btnAskAI"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:text="@string/get_ai_advice" />

    <ProgressBar
        android:id="@+id/aiLoader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAiResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/ai_initial_text"
        android:textColor="@color/black"
        android:textSize="16sp" />
</LinearLayout>